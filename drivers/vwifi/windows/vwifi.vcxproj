<?xml version="1.0" encoding="utf-8"?>
<!--
  vwifi — Windows WDI miniport for the vwifi-virt QEMU device.

  Builds with the EWDK (LaunchBuildEnv.cmd, then msbuild) or with
  Visual Studio 2022 + the WDK. See README.md for the full procedure.

  Debug|x64 is the configuration to use for bring-up: no optimisation,
  full PDBs, DBG=1 so the driver's assertions and verbose logging are
  compiled in, and no signing step (sign.cmd does that separately, so
  a missing test certificate can't fail the build).
-->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{6B1F0A7C-9D4E-4A21-B3C8-5E2F7A0D9C14}</ProjectGuid>
    <TemplateGuid>{497e31cb-056b-4f31-abb8-447fd55ee5a5}</TemplateGuid>
    <RootNamespace>vwifi</RootNamespace>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
    <DriverTargetPlatform>Desktop</DriverTargetPlatform>
    <TargetVersion>Windows10</TargetVersion>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <MinimumVisualStudioVersion>14.0</MinimumVisualStudioVersion>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
            Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />

  <PropertyGroup>
    <TargetName>vwifi</TargetName>
    <!-- Sign as a separate, explicit step (sign.cmd). A build that
         silently depends on a certificate in the local store is a
         build that works on one machine. -->
    <SignMode>Off</SignMode>
    <EnableInf2Cat>false</EnableInf2Cat>
    <!-- Spectre-mitigated runtime libs are an optional EWDK/VS component.
         Requiring them would fail the build on a stock EWDK mount for no
         benefit to a virtual device used for testing. -->
    <SpectreMitigation>false</SpectreMitigation>
    <!-- Code analysis and Static Driver Verifier are worth running, but
         not on every incremental bring-up build. Run them explicitly:
           msbuild /p:RunCodeAnalysis=true ... -->
    <RunCodeAnalysis>false</RunCodeAnalysis>
    <EnablePREfast>false</EnablePREfast>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- The ABI header is shared verbatim with the QEMU device and
           lives once at the top of the repo. Never copy it here.

           WdiTlvIncludeDir is where TlvGeneratorParser.hpp lives. That
           header is not in the kit's default include path the way
           dot11wdi.h and wditypes.hpp are, so build.cmd locates it and
           passes it in; override with /p:WdiTlvIncludeDir=<path> if
           yours is somewhere else. Empty entries are harmless. -->
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)src;$(MSBuildThisFileDirectory)..\..\..\abi;$(WdiTlvIncludeDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- WDI requires NDIS 6.50, which is what driver.c registers with. -->
      <PreprocessorDefinitions>NDIS_MINIPORT_DRIVER;NDIS650_MINIPORT=1;NDIS_WDM=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <WarningLevel>Level4</WarningLevel>
      <!-- Off for bring-up so one warning doesn't hide the other fifty.
           Turn it back on once the driver builds clean. -->
      <TreatWarningAsError>false</TreatWarningAsError>
      <ExceptionHandling>false</ExceptionHandling>
      <RuntimeTypeInfo>false</RuntimeTypeInfo>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <!-- The WDI TLV generator/parser is a static library, not the
           header-only template pack it looks like: TlvGenerated_.hpp
           declares ParseWdi*/GenerateWdi*/FreeGenerated and defines
           none of them. tlv_mem.cpp's own comment says as much —
           "consumers of the library must provide overloaded operator
           implementations of these APIs when linking to the library".
           build.cmd locates it; override with /p:WdiTlvLib=<path>.
           An empty entry is harmless. -->
      <!-- ntstrsafe for RtlStringCchVPrintfA, used by the port-0xE9
           logger. The header inlines most of these, but which ones are
           inline varies by kit and an unresolved external here is a
           pointless round trip. -->
      <AdditionalDependencies>$(DDK_LIB_PATH)ndis.lib;$(DDK_LIB_PATH)ntstrsafe.lib;$(WdiTlvLib);%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Inf>
      <!-- stampinf writes DriverVer as <date>,<TimeStamp>, and the date
           is only a date. A fixed version therefore produces an
           identical DriverVer for every build on the same day, and
           Windows has no reason to prefer the new package over the
           installed one — you reinstall and keep testing the old .sys.
           build.cmd passes a version derived from the build time so
           each build strictly supersedes the last. -->
      <TimeStamp>$(VwifiInfVersion)</TimeStamp>
    </Inf>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <!-- OldStyle (/Z7) puts debug info in the .obj files instead of a
           shared compiler PDB. The linker still emits a full vwifi.pdb,
           which is what WinDbg wants, but nothing depends on vc145.pdb
           existing and being findable at link time. That dependency is
           fragile — mspdbsrv writing a shared PDB across a mapped or
           network drive is enough to lose it, and the loss shows up as
           LNK4099 at link, long after the compile "succeeded". -->
      <DebugInformationFormat>OldStyle</DebugInformationFormat>
      <PreprocessorDefinitions>DBG=1;DEPRECATE_DDK_FUNCTIONS=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <!-- The driver targets pass /WX to the *linker* as well, and
           TreatWarningAsError above only governs the compiler. A link
           warning is not a good reason to produce no binary during
           bring-up. Turn this back on with the compiler's. -->
      <TreatLinkerWarningAsErrors>false</TreatLinkerWarningAsErrors>
      <!-- A linker map, because the .pdb is only readable by Windows
           tooling. When the guest dies without a bugcheck the only
           record of where the CPU was is an absolute RIP in QEMU's log
           on the Linux host, and the map is what turns that into a
           function name there. rip2sym.py reads it. -->
      <GenerateMapFile>true</GenerateMapFile>
      <MapFileName>$(OutDir)vwifi.map</MapFileName>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <DebugInformationFormat>OldStyle</DebugInformationFormat>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="src\data.c" />
    <ClCompile Include="src\driver.c" />
    <ClCompile Include="src\hardware.c" />
    <ClCompile Include="src\monitor.c" />
    <ClCompile Include="src\oids.c" />
    <ClCompile Include="src\rings.c" />
    <ClCompile Include="src\wdi_common.c" />
    <ClCompile Include="src\wdi_connect.c" />
    <ClCompile Include="src\wdi_keys.c" />
    <ClCompile Include="src\wdi_ops.c" />
    <ClCompile Include="src\wdi_scan.c" />
    <ClCompile Include="src\wdi_tal.c" />
    <!-- The WDI TLV generator/parser is C++ templates. These two
         translation units are the only C++ in the driver; everything
         else reaches them through tlv_shim.h's plain-C boundary. -->
    <ClCompile Include="src\tlv_mem.cpp">
      <CompileAs>CompileAsCpp</CompileAs>
    </ClCompile>
    <ClCompile Include="src\tlv_shim.cpp">
      <CompileAs>CompileAsCpp</CompileAs>
    </ClCompile>
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="src\tlv_shim.h" />
    <ClInclude Include="src\vwifi_drv.h" />
    <ClInclude Include="..\..\..\abi\vwifi_abi.h" />
  </ItemGroup>

  <ItemGroup>
    <Inf Include="inf\vwifi.inx" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
