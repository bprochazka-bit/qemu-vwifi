#!/usr/bin/env python3
#
# vwifi-pseudohost — command-line entry point
#
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Phase 1: give it an ESSID (and a passphrase for a protected network),
# and it joins the vwifi medium, finds the channel, associates, and
# pulls a DHCP lease — then stays on the air answering ICMP and whatever
# services its device profile runs.
#
#   ./pseudohost --sock /tmp/vwifi.sock --essid Lab-AP-1 \
#                --passphrase correcthorse1
#
#   ./pseudohost --sock /tmp/vwifi.sock --essid Lab-AP-1 \
#                --passphrase correcthorse1 --profile printer
#
import argparse
import os
import signal
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from vwifi_pseudohost.profiles import get_profile, profile_names  # noqa: E402
from vwifi_pseudohost.netstack import ip_str                       # noqa: E402
from vwifi_pseudohost import introspect                            # noqa: E402


def build_parser():
    p = argparse.ArgumentParser(
        prog="pseudohost",
        description="Join a vwifi network as a virtual host (no VM).")
    p.add_argument("--dump-config", action="store_true",
                   help="print a JSON descriptor of this device type's "
                        "configurable parameters and exit (used by tools "
                        "that build a UI or validate configs)")
    p.add_argument("--sock", required=True,
                   help="path to the vwifi-medium hub socket")
    p.add_argument("--essid", required=True,
                   help="network name (ESSID) to find and join")
    p.add_argument("--passphrase", default=None,
                   help="WPA2-PSK passphrase (omit for an open network)")
    p.add_argument("--profile", default="generic", choices=profile_names(),
                   help="device profile to impersonate (default: generic)")
    p.add_argument("--node-id", default=None,
                   help="name shown to the hub in LIST_PEERS (default: auto)")
    p.add_argument("--hostname", default=None,
                   help="DHCP/host name (default: the profile's)")
    p.add_argument("--mac", default=None,
                   help="station MAC, e.g. 02:1a:11:aa:bb:cc (default: random)")
    p.add_argument("--print-dir", default=None,
                   help="for printer profiles: write accepted print jobs to "
                        "files in this directory (default: discard to null)")
    p.add_argument("--scan-time", type=float, default=3.0,
                   help="seconds to look for the ESSID before giving up")
    p.add_argument("--connect-timeout", type=float, default=20.0,
                   help="overall association timeout in seconds")
    p.add_argument("--ping", default=None,
                   help="after leasing, ping this IPv4 address once")
    p.add_argument("--duration", type=float, default=None,
                   help="run for N seconds then exit (default: run forever)")
    p.add_argument("-v", "--verbose", action="store_true",
                   help="log every received data frame (source, ethertype) "
                        "on top of the per-service logs, to diagnose traffic")
    p.add_argument("-q", "--quiet", action="store_true",
                   help="suppress the progress log")
    return p


def _profiles_extra():
    """Describe each selectable profile so a UI can label the --profile
    choices with the persona/hostname they impersonate."""
    out = []
    for name in profile_names():
        cls = get_profile(name)
        out.append({
            "name": name,
            "persona": getattr(cls, "persona", name),
            "hostname": getattr(cls, "hostname", ""),
        })
    return out


def main(argv=None):
    # --dump-config short-circuits argument validation: a caller asking for
    # the config descriptor has not supplied --sock/--essid, and shouldn't
    # need to. parse_known_args tolerates the missing required args.
    if argv is None:
        argv = sys.argv[1:]
    if "--dump-config" in argv:
        print(introspect.dump_descriptor(
            build_parser(), device_type="wifi-host",
            binary="vwifi-pseudohost",
            extras={"profiles": _profiles_extra()}))
        return 0

    args = build_parser().parse_args(argv)

    profile = get_profile(args.profile)
    if profile is None:
        print("unknown profile: %s" % args.profile, file=sys.stderr)
        return 2

    def log(msg):
        if not args.quiet:
            print(msg, file=sys.stderr, flush=True)

    host = profile(args.sock, args.essid, passphrase=args.passphrase,
                   node_id=args.node_id, hostname=args.hostname, mac=args.mac,
                   scan_time=args.scan_time, log=log, print_dir=args.print_dir,
                   verbose=args.verbose)

    stop = {"flag": False}

    def _sig(_signum, _frame):
        stop["flag"] = True
        host.stop()
    signal.signal(signal.SIGINT, _sig)
    signal.signal(signal.SIGTERM, _sig)

    try:
        try:
            connected = host.start(connect_timeout=args.connect_timeout)
        except (FileNotFoundError, ConnectionRefusedError) as e:
            print("cannot reach hub at %s: %s" % (args.sock, e),
                  file=sys.stderr)
            return 1
        if not connected:
            print("failed to join '%s'" % args.essid, file=sys.stderr)
            return 1

        # Run until we have a lease (or the connect window closes), then
        # optionally ping and settle into the service loop.
        import time
        deadline = time.time() + max(5.0, args.connect_timeout)
        while not host.dhcp.bound() and time.time() < deadline \
                and not stop["flag"]:
            host.run(duration=0.2)
        if host.dhcp.bound():
            log("[%s] online as %s" % (host.node_id, ip_str(host.ip)))
            if args.ping:
                host.ping(args.ping)
        else:
            log("[%s] associated but no DHCP lease yet" % host.node_id)

        host.run(duration=args.duration)
    finally:
        host.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
